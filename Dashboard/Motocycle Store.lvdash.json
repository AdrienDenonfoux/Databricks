    {
      "name": "57573279",
      "displayName": "Active Customers",
      "queryLines": [
        "USE CATALOG `demoworkspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT COUNT(DISTINCT customer_id) AS active_customers FROM demoworkspace.motocycle_bundle.orders_raw;"
      ]
    },
    {
      "name": "4a064aa6",
      "displayName": "Explode Motocycle Order",
      "queryLines": [
        "USE CATALOG `demoworkspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "WITH exploded_orders AS (\n",
        "  SELECT\n",
        "    m.motocycle_id,\n",
        "    m.quantity,\n",
        "    m.subtotal,\n",
        "    o.order_id,\n",
        "    o.customer_id,\n",
        "    o.order_timestamp\n",
        "  FROM demoworkspace.motocycle_bundle.orders_cleaned o\n",
        "  LATERAL VIEW explode(o.motocycles) exploded AS m\n",
        ")\n",
        "SELECT\n",
        "    o.*,\n",
        "    m.brand,\n",
        "    m.name,\n",
        "    m.category,\n",
        "    m.engine_displacement_cc,\n",
        "    m.horsepower,\n",
        "    m.price\n",
        "FROM exploded_orders o\n",
        "INNER JOIN demoworkspace.default.motocycles m\n",
        "ON m.motocycle_id = o.motocycle_id"
      ]
    },
    {
      "name": "20524a53",
      "displayName": "Customer Location",
      "queryLines": [
        "USE CATALOG `demoworkspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT \n",
        "    customer_id,\n",
        "    email,\n",
        "    updated,\n",
        "    profile.adresse.street,\n",
        "    profile.adresse.city,\n",
        "    profile.adresse.country,\n",
        "    profile.first_name,\n",
        "    profile.last_name\n",
        "FROM demoworkspace.motocycle_bundle.customers"
      ]
    }
  ],

    {
      "name": "2be98315",
      "displayName": "Order Count",
      "queryLines": [
        "USE CATALOG `demoworkspace`;\n",
        "USE SCHEMA `adriendenonfoux1`;\n",
        "\n",
        "SELECT\n",
        "  COUNT(*) AS nb_orders\n",
        "FROM\n",
        "  orders_raw"
      ]
    },
